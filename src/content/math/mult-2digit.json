[
  { "id": "m2d-001", "skill": "mult_2digit", "difficulty": 1, "prompt": "23 × 4 = ?", "answer": 92, "operands": [23, 4], "op": "*", "explanation": "23 = 20 + 3. 20 × 4 = 80. 3 × 4 = 12. 80 + 12 = 92." },
