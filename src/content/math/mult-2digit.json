  { "id": "m2d-031", "skill": "mult_2digit", "difficulty": 4, "prompt": "47 × 56 = ?", "answer": 2632, "operands": [47, 56], "op": "*", "explanation": "בעמודות: 47 × 6 = 282 (ספרת היחידות של 56). 47 × 5 = 235 — זה עשרות, אז 2350. חיבור: 282 + 2350 = 2632." },
  { "id": "m2d-032", "skill": "mult_2digit", "difficulty": 4, "prompt": "68 × 79 = ?", "answer": 5372, "operands": [68, 79], "op": "*", "explanation": "בעמודות: 68 × 9 = 612. 68 × 7 = 476 — עשרות, אז 4760. חיבור: 612 + 4760 = 5372." },
  { "id": "m2d-033", "skill": "mult_2digit", "difficulty": 4, "prompt": "53 × 84 = ?", "answer": 4452, "operands": [53, 84], "op": "*", "explanation": "בעמודות: 53 × 4 = 212. 53 × 8 = 424 — עשרות, אז 4240. חיבור: 212 + 4240 = 4452." },
  { "id": "m2d-034", "skill": "mult_2digit", "difficulty": 4, "prompt": "67 × 48 = ?", "answer": 3216, "operands": [67, 48], "op": "*", "explanation": "בעמודות: 67 × 8 = 536. 67 × 4 = 268 — עשרות, אז 2680. חיבור: 536 + 2680 = 3216." },
  { "id": "m2d-035", "skill": "mult_2digit", "difficulty": 4, "prompt": "89 × 35 = ?", "answer": 3115, "operands": [89, 35], "op": "*", "explanation": "בעמודות: 89 × 5 = 445. 89 × 3 = 267 — עשרות, אז 2670. חיבור: 445 + 2670 = 3115." },
  { "id": "m2d-036", "skill": "mult_2digit", "difficulty": 4, "prompt": "76 × 54 = ?", "answer": 4104, "operands": [76, 54], "op": "*", "explanation": "בעמודות: 76 × 4 = 304. 76 × 5 = 380 — עשרות, אז 3800. חיבור: 304 + 3800 = 4104." },

  { "id": "m2d-041", "skill": "mult_2digit", "difficulty": 5, "prompt": "50 × 85 = ?", "answer": 4250, "operands": [50, 85], "op": "*", "explanation": "טריק: 50 = חצי מ-100. 85 × 100 = 8500, חצי = 4250. (בעמודות: 50 × 5 = 250, 50 × 8 = 400 → 4000, חיבור: 250 + 4000 = 4250.)" },
  { "id": "m2d-042", "skill": "mult_2digit", "difficulty": 5, "prompt": "99 × 11 = ?", "answer": 1089, "operands": [99, 11], "op": "*", "explanation": "טריק: 99 × 11 = 99 × 10 + 99 = 990 + 99 = 1089. (בעמודות: 99 × 1 = 99, 99 × 1 = 99 → 990, חיבור: 99 + 990 = 1089.)" },
  { "id": "m2d-043", "skill": "mult_2digit", "difficulty": 5, "prompt": "99 × 99 = ?", "answer": 9801, "operands": [99, 99], "op": "*", "explanation": "טריק: 99 × 99 = 99 × 100 − 99 = 9900 − 99 = 9801." },
  { "id": "m2d-044", "skill": "mult_2digit", "difficulty": 5, "prompt": "75 × 80 = ?", "answer": 6000, "operands": [75, 80], "op": "*", "explanation": "טריק: שני המספרים עם 0 או 5 ביחידות. 75 × 8 = 600, אחר כך מכפילים ב-10 (כי 80 = 8 × 10) → 6000." },
  { "id": "m2d-045", "skill": "mult_2digit", "difficulty": 5, "prompt": "63 × 97 = ?", "answer": 6111, "operands": [63, 97], "op": "*", "explanation": "טריק (97 קרוב ל-100): 63 × 100 − 63 × 3 = 6300 − 189 = 6111. (בעמודות: 63 × 7 = 441, 63 × 9 = 567 → 5670, חיבור: 441 + 5670 = 6111.)" },
  { "id": "m2d-046", "skill": "mult_2digit", "difficulty": 5, "prompt": "25 × 40 = ?", "answer": 1000, "operands": [25, 40], "op": "*", "explanation": "טריק: 25 × 4 = 100. 25 × 40 = 100 × 10 = 1000." }
